## template:jinja
# {{ ansible_managed }} (infra/ansible/roles/common/templates/hosts.j2).
# Do not edit this file by hand. Ansible will replace your changes.
127.0.1.1 {{ inventory_hostname }} {{ inventory_hostname }}
127.0.0.1 localhost

# The other machines in the homelab. This list comes from the Ansible inventory.
# This machine is not in the list. Its name is on the 127.0.1.1 line above.
{% for host in groups['all'] | difference(groups['proxmox'] | default([])) | sort if host != inventory_hostname %}
{{ hostvars[host]['ansible_host'] }} {{ host }}
{% endfor %}

# IPv6 addresses
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
