# Copy to terraform.tfvars and fill in real values. terraform.tfvars is git-ignored.

proxmox_endpoint  = "https://192.168.1.10:8006/"
proxmox_api_token = "tofu@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

node_name       = "pve"
vm_datastore    = "local-lvm"
image_datastore = "local"
bridge          = "vmbr0"

gateway        = "192.168.1.1"
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Pick IPs OUTSIDE your router's DHCP range.
vms = {
  "k8s-cp" = {
    vm_id   = 201
    cores   = 2
    memory  = 4096
    disk_gb = 40
    ip      = "192.168.1.21/24"
  }
  "k8s-worker" = {
    vm_id   = 202
    cores   = 6
    memory  = 16384
    disk_gb = 100
    ip      = "192.168.1.22/24"
  }
  "monitoring" = {
    vm_id   = 203
    cores   = 2
    memory  = 2048
    disk_gb = 40
    ip      = "192.168.1.23/24"
  }
}
